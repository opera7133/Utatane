    "ゴーストがメールチェックを要求した時だけ接続する。通常はPOP3 over TLSの995番を使う。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects only when a ghost requests a mail check. POP3 over TLS normally uses port 995."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고스트가 메일 확인을 요청할 때만 연결합니다. POP3 over TLS는 보통 995번 포트를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在 Ghost 请求检查邮件时连接。POP3 over TLS 通常使用 995 端口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在 Ghost 要求檢查郵件時連線。POP3 over TLS 通常使用 995 連接埠。"
          }
        }
      }
    },
