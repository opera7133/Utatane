    },
    "ゴーストの再読み込み、低速アニメーション、再生の進行・停止、ログ確認は上部の操作とログ画面から利用できる。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the controls above and the log view to reload ghosts, slow animations, advance or stop playback, and inspect logs."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위쪽 조작부와 로그 화면에서 고스트 새로고침, 느린 애니메이션, 재생 진행과 정지, 로그 확인을 할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可通过上方控件和日志界面重新加载 Ghost、慢速播放动画、推进或停止播放以及查看日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可透過上方控制項及記錄畫面重新載入 Ghost、慢速播放動畫、推進或停止播放及查看記錄。"
          }
        }
      }
    },
