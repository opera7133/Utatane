    "「%@」は「%@」向けに作られています。現在のゴースト「%@」で使うと、表示が崩れることがあります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” was made for “%@”. It may not display correctly with the current ghost “%@”."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) ‘%@’용으로 제작되었습니다. 현재 고스트 ‘%@’에서 사용하면 표시가 깨질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是为“%@”制作的。用于当前 Ghost“%@”时，显示可能会错乱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是為「%@」製作的。用於目前 Ghost「%@」時，顯示可能會錯亂。"
          }
        }
      }
    },
