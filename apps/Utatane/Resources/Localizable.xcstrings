    "一覧からコンテンツを選ぶと詳細を表示する。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select content from the list to view its details."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에서 콘텐츠를 선택하면 상세 정보를 표시합니다."
          }
        },
        "zh-Hans" : {
