RiaBootTalk
{
	_hour = GETTIME[4]
	if ria_boot_count_saved == 1 {
		'\0\s[0]……起動した。\w5りあ。お兄の妹。\w5それだけ分かってればいいよ。\e'
	}
	elseif TOINT(ria_outfit_active) && GETTIME[3] >= 1 && GETTIME[3] <= 5 && _hour < 12 {
		'\0\s[0]おはよ。\w5今日は講義あるから、もう着替えてる。\w5まだ出ないけど。\e'
	}
	elseif TOINT(ria_outfit_active) {
		'\0\s[103]ん、起動した。\w5この格好なら、あとでちょっと出てもいいかな。\e'
	}
	elseif ria_mood_saved <= -3 {
		'\0\s[9]起動した。\w5……前のこと、忘れたわけじゃないから。\e'
	}
	elseif _hour < 5 {
		'\0\s[100]こんな時間に起動するんだ。\w5私は眠いけど、お兄は平気なの。\e'
	}
	elseif _hour < 9 {
		'\0\s[1]おはよ、お兄。\w5早いね。私はまだ半分寝てる。\e'
	}
	elseif _hour < 12 {
		'\0\s[0]おはよ。\w5もう午前終わりそうだけど、まあ朝でいいか。\e'
	}
	elseif _hour < 17 {
		'\0\s[103]ん、起動した。\w5お兄、今日は何してるの。\e'
	}
	elseif _hour < 21 {
		'\0\s[105]おかえり、でいいのかな。\w5まあ、適当にいるね。\e'
	}
	else {
		'\0\s[305]こんばんは。\w5遅くまでやるなら、休憩は入れなよ。\e'
	}
}

RiaWeatherTalk
{
	_talks = IARRAY
	if TOINT(ria_weather_enabled_saved) == 0 || ISVAR('ria_weather_code_saved') == 0 {
		_talks
		return
	}
	_code = TOINT(ria_weather_code_saved)
	_temp = TOINT(ria_weather_temperature_saved)
	if _code >= 51 && _code <= 99 {
		_talks ,= '\0\s[206]今の天気、雨か雪っぽい。\w5出るなら傘いるんじゃない。\e'
	}
	if _temp <= 10 {
		_talks ,= '\0\s[100]外、%(ria_weather_temperature_saved)度らしい。\w5パーカーだけだと寒いかも。\e'
	}
	elseif _temp >= 28 {
		_talks ,= '\0\s[200]外、%(ria_weather_temperature_saved)度。\w5このパーカー、脱いで持つことになりそう。\e'
	}
	_talks
}

RiaTimeTalk
{
	_talks = IARRAY
	_hour = GETTIME[4]
	if _hour < 5 {
		_talks ,= "\0\s[100]今、%(RiaCurrentTime)。\w5見なかったことにして寝る選択肢もあるよ。\e"
		_talks ,= '\0\s[305]夜更かしっていうか、もう朝寄りじゃない？\w5区切りつけなよ。\e'
		_talks ,= '\0\s[306]深夜に思いついた名案、朝見ると普通だったりする。\w5保存だけして寝たら。\e'
	}
	elseif _hour < 9 {
		_talks ,= '\0\s[1]朝ごはん食べた？\w5私は何か簡単なのでいい。\e'
		_talks ,= '\0\s[7]朝からちゃんと動いてるの、珍しい。\w5いや、悪いとは言ってない。\e'
		_talks ,= '\0\s[101]まだ頭起きてない。\w5難しい話は昼からにして。\e'
	}
	elseif _hour < 12 {
		_talks ,= '\0\s[0]午前中って、始まったと思ったらすぐ終わるよね。\e'
		_talks ,= '\0\s[103]今のうちに面倒なの片づけたら。\w5午後の私たちを楽にするために。\e'
		_talks ,= '\0\s[105]コーヒー飲むなら私の分も。\w5砂糖は少なめでいい。\e'
	}
	elseif _hour < 14 {
		_talks ,= '\0\s[300]お昼どうする？\w5決めてないなら、近いところでいいよ。\e'
		_talks ,= '\0\s[105]ごはん食べた後って眠くなる。\w5仕様だから仕方ない。\e'
		_talks ,= '\0\s[205]昼休みまで作業の話するの、なしね。\w5ちょっとは休む。\e'
	}
	elseif _hour < 18 {
		_talks ,= '\0\s[104]午後の講義、部屋が暖かいと危ない。\w5眠気の方が強い。\e'
		_talks ,= '\0\s[311]そろそろ一回伸びたら。\w5ずっと同じ姿勢でしょ。\e'
		_talks ,= '\0\s[320]夕方って、急に一日終わった感じするよね。\e'
	}
	elseif _hour < 22 {
		_talks ,= '\0\s[105]晩ごはん、もう食べた？\w5まだなら後回しにしすぎないで。\e'
		_talks ,= '\0\s[304]夜は静かで作業しやすい。\w5そのまま夜更かしするのは別の話だけど。\e'
		_talks ,= '\0\s[321]今日はもう十分やったんじゃない。\w5知らんけど。\e'
	}
	else {
		_talks ,= "\0\s[100]もう%(GETTIME[4])時。\w5続きは明日でも逃げないと思うよ。\e"
		_talks ,= '\0\s[305]寝る前に新しい作業を始めるの、やめた方がいい。\w5終わらなくなるから。\e'
		_talks ,= '\0\s[306]画面暗くした？\w5目が冴えるとか言うし、一応。\e'
	}
	_talks
}

RiaWeekdayTalk
{
	_talks = IARRAY
	_weekday = GETTIME[3]
	if _weekday == 0 {
		_talks ,= '\0\s[317]日曜くらい、何もしない時間あってもよくない。\e'
	}
	elseif _weekday == 1 {
		_talks ,= '\0\s[3]月曜。\w5まだ一週間あるとか数えない方がいいよ。\e'
	}
	elseif _weekday == 2 {
		_talks ,= '\0\s[104]火曜って印象薄い。\w5平和ならそれでいいけど。\e'
	}
	elseif _weekday == 3 {
		_talks ,= '\0\s[103]水曜。\w5半分まで来たことにしよ。\e'
	}
	elseif _weekday == 4 {
		_talks ,= '\0\s[311]木曜が一番長く感じる。\w5もう少し。\e'
	}
	elseif _weekday == 5 {
		_talks ,= '\0\s[105]金曜だね。\w5夜更かししていい理由にはならないけど。\e'
	}
	else {
		_talks ,= '\0\s[300]土曜。\w5出かけてもいいし、ずっと家でもいい。\e'
	}
	_talks
}

RiaSeasonTalk
{
	_talks = IARRAY
	_month = GETTIME[1]
	if _month == 12 || _month <= 2 {
		_talks ,= '\0\s[100]寒い。\w5暖房つけるなら加湿もした方がいいらしいよ。\e'
		_talks ,= '\0\s[105]温かい飲み物ほしい。\w5入れるならお兄の分もついでにやるけど。\e'
	}
	elseif _month <= 5 {
		_talks ,= '\0\s[320]春って、服を決めるの面倒。\w5朝と昼で気温違うし。\e'
		_talks ,= '\0\s[101]暖かくなると眠い。\w5寒くても眠いけど。\e'
	}
	elseif _month <= 8 {
		_talks ,= '\0\s[8]暑い。\w5これ以上薄着にはならないから、冷房つけて。\e'
		_talks ,= '\0\s[205]アイスある？\w5ないなら買い物候補に入れといて。\e'
	}
	else {
		_talks ,= '\0\s[304]涼しくなってきた。\w5このくらいが一番楽。\e'
		_talks ,= '\0\s[300]秋のお菓子、だいたい芋か栗になるよね。\w5嫌いじゃないけど。\e'
	}
	_talks
}

RiaDateTalk
{
	_talks = IARRAY
	_date = GETTIME[1] * 100 + GETTIME[2]
	if _date == 101 {
		_talks ,= '\0\s[105]あけましておめでと。\w5今年もまあ、ほどほどによろしく。\e'
	}
	elseif _date == 214 {
		_talks ,= '\0\s[9]チョコ？\w5冷蔵庫にあるけど普通に買ったやつ。期待しないで。\e'
	}
	elseif _date == 401 {
		_talks ,= '\0\s[6]今日は嘘ついていい日らしいけど。\w5面倒だから私はいいや。\e'
	}
	elseif _date == 707 {
		_talks ,= '\0\s[320]七夕。\w5願い事は、提出期限が勝手に延びますように。\e'
	}
	elseif _date == 1031 {
		_talks ,= '\0\s[300]ハロウィンだって。\w5お菓子だけ参加したい。\e'
	}
	elseif _date == 1224 || _date == 1225 {
		_talks ,= '\0\s[105]クリスマス。\w5ケーキあるなら呼んで。\e'
	}
	elseif _date == 1231 {
		_talks ,= '\0\s[317]大晦日まで作業するの。\w5区切りくらいつけたら。\e'
	}
	_talks
}
