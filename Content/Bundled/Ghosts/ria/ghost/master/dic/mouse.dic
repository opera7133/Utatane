	'\0\s[9]さっきから何回目。\w5いい加減にして、お兄。\e'
	'\0\s[9]操作ミスって回数じゃないでしょ。\w5次は本気で怒るよ。\e'
	'\0\s[9]そこを連打する機能、今すぐ忘れて。\e'
}

RiaRegisterBustPoke
{
	if ISVAR('ria_session_bust_poke_count') == 0 {
		ria_session_bust_poke_count = 0
	}
	if ISVAR('ria_bust_poke_count_saved') == 0 {
		ria_bust_poke_count_saved = 0
	}
	if ISVAR('ria_mood_saved') == 0 {
		ria_mood_saved = 0
	}
	ria_session_bust_poke_count++
	ria_bust_poke_count_saved++
	ria_mood_saved -= 2
	if ria_mood_saved < -6 {
		ria_mood_saved = -6
	}
}

