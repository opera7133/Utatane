RiaHairStrokeTalk
{
	if TOINT(ria_spoiling_until) > GETSECCOUNT() {
		_talks = RiaSpoilingHairStrokeTalks
		_talks[RAND(ARRAYSIZE(_talks))]
		return
	}
	_talks = RiaHairStrokeTalks
	_talks[RAND(ARRAYSIZE(_talks))]
}

