OnMouseDoubleClick
{
	if reference3 != 0 {
		return
	}

	if RiaRegisterTouchSequence {
		if ria_mood_saved >= 4 && (TOINT(ria_secret_talk_count_saved) % 3) == 0 {
			RiaStartSpoilingMode
			'\0\s[1]……だめ。急にお兄のこと、すごく好きになった。\w5\s[5]五分だけ全部忘れて、私のことだけ構って。\e'
		}
		else {
			_talks = RiaSecretTouchTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
	}
	elseif reference4 == 'Head' {
		if ria_mood_saved <= -4 {
			_talks = RiaAnnoyedHeadDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
		else {
			_talks = RiaHeadDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
	}
	elseif reference4 == 'Face' || reference4 == 'Eye' || reference4 == 'Mouth' {
		if ria_mood_saved <= -4 {
			_talks = RiaAnnoyedFaceDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
		else {
			_talks = RiaFaceDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
	}
	elseif reference4 == 'Bust' {
		if TOINT(ria_spoiling_until) > GETSECCOUNT() {
			_talks = RiaSpoilingBustDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
			return
		}
		RiaRegisterBustPoke
		if TOINT(ria_outfit_active) && ria_session_bust_poke_count < 3 {
			'\0\s[9]パーカーの上からでも、そこはそこだから。\w5触らないで。\e'
			return
		}
		if ria_session_bust_poke_count >= 3 {
			_talks = RiaRepeatedBustDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
		else {
			_talks = RiaBustDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
	}
	elseif reference4 == 'Hand' {
		if TOINT(ria_spoiling_until) > GETSECCOUNT() {
			RiaSpoilingHandMenu
		}
		elseif ria_mood_saved <= -4 {
			_talks = RiaAnnoyedHandDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
		else {
			_talks = RiaHandDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
	}
	elseif reference4 == 'Leg' {
		if TOINT(ria_spoiling_until) > GETSECCOUNT() {
			_talks = RiaSpoilingLegDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
		elseif TOINT(ria_outfit_active) && RAND(3) == 0 {
			'\0\s[202]スカートの裾、気になる？\w5私は別に。お兄が触らなければ。\e'
			return
		}
		_talks = RiaLegDoubleClickTalks
		_talks[RAND(ARRAYSIZE(_talks))]
	}
	else {
		if TOINT(ria_spoiling_until) > GETSECCOUNT() {
			_talks = RiaSpoilingOtherDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
		else {
			_talks = RiaOtherDoubleClickTalks
			_talks[RAND(ARRAYSIZE(_talks))]
		}
	}
}

RiaRegisterTouchSequence
{
	_region = reference4
	_found = 0
	if ria_touch_sequence == 0 && _region == 'Head' {
		ria_touch_sequence = 1
	}
	elseif ria_touch_sequence == 1 && _region == 'Hand' {
		ria_touch_sequence = 2
	}
	elseif ria_touch_sequence == 2 && _region == 'Head' {
		ria_touch_sequence = 3
	}
	elseif ria_touch_sequence == 3 && (_region == 'Face' || _region == 'Eye' || _region == 'Mouth') {
		ria_touch_sequence = 0
		ria_secret_talk_count_saved++
		_found = 1
	}
	elseif _region == 'Head' {
		ria_touch_sequence = 1
	}
	else {
		ria_touch_sequence = 0
	}
	_found
}

RiaSecretTouchTalks : array
{
	'\0\s[103]……その順番、よく見つけたね。\w5別に何も出ないけど、隠し反応はこれ。\e'
	'\0\s[105]隠し反応の正解。\w5頭、手、頭、顔。\w5覚えても特に得はないよ。\e'
	'\0\s[4]隠し順まで試す人、お兄くらいでしょ。\w5一応、記録しとく。\e'
}

