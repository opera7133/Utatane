OnMouseMove
{
	if reference3 != 0 {
		ria_stroke_count = 0
		return
	}

	_region = reference4
	if _region != 'Head' && _region != 'Hair' {
		ria_stroke_count = 0
		ria_stroke_region = ''
		return
	}

	_now = GETTICKCOUNT
	if _region != ria_stroke_region || (_now - TOINT(ria_stroke_timer)) > 1500 {
		ria_stroke_count = 0
	}

	ria_stroke_region = _region
	ria_stroke_timer = _now
	ria_stroke_count++
	_threshold = 64
	if _region == 'Hair' {
		_threshold = 64
	}

	if ria_stroke_count >= _threshold {
		ria_stroke_count = 0
		RiaRegisterPet
		if _region == 'Hair' {
			RiaHairStrokeTalk
		}
		else {
			RiaHeadPetTalk
		}
	}
}

RiaRegisterPet
{
	if ISVAR('ria_pet_count_saved') == 0 {
		ria_pet_count_saved = 0
	}
	if ISVAR('ria_session_pet_count') == 0 {
		ria_session_pet_count = 0
	}
	if ISVAR('ria_mood_saved') == 0 {
		ria_mood_saved = 0
	}
	if ISVAR('ria_pet_timer') == 0 {
		ria_pet_timer = 0
	}
	_now = GETTICKCOUNT
	if (_now - TOINT(ria_pet_timer)) > 300000 {
		ria_session_pet_count = 0
	}
	ria_pet_timer = _now
	ria_pet_count_saved++
	ria_session_pet_count++
	ria_session_apology_count = 0
	if ria_mood_saved < 6 {
		ria_mood_saved++
	}
}

OnMouseWheel
{
	if reference3 != 0 {
		return
	}

	if reference4 == 'Hair' {
		_talks = RiaHairWheelTalks
		_talks[RAND(ARRAYSIZE(_talks))]
	}
	elseif reference4 == 'Head' {
		'\0\s[9]ちょっと、髪型崩れる。\w5スクロールする場所そこじゃないでしょ。\e'
	}
}

RiaHairWheelTalks : array
{
	'\0\s[4]髪をスクロールしてどうするの。\w5伸びたりしないよ。\e'
	'\0\s[108]それ、ブラシの代わり？\w5雑すぎると思う。\e'
	'\0\s[6]毛先で遊ばない。\w5絡まったらお兄が直してよ。\e'
}

RiaHeadPetTalk
{
	if TOINT(ria_spoiling_until) > GETSECCOUNT() {
		_talks = RiaSpoilingPetTalks
		_talks[RAND(ARRAYSIZE(_talks))]
		return
	}
	if ria_session_pet_count >= 7 {
		_talks = RiaTooMuchPetTalks
		_talks[RAND(ARRAYSIZE(_talks))]
	}
	elseif ria_mood_saved >= 4 {
		_talks = RiaGoodMoodPetTalks
		_talks[RAND(ARRAYSIZE(_talks))]
	}
	else {
		_talks = RiaHeadPetTalks
		_talks[RAND(ARRAYSIZE(_talks))]
	}
}

