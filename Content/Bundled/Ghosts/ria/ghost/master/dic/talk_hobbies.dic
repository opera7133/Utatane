RiaHobbyTalks : array
{
	'\0\s[304]プレイリスト作ってたら、聴く前に一時間経った。\e'
	'\0\s[103]ゲーム始める前の設定画面、結構好き。\w5細かくしても違い分からないけど。\e'
	'\0\s[317]積んでる本、積んである状態が一番きれいかもしれない。\e'
	'\0\s[304]同じ曲を続けて聴きすぎて、最初の音だけで次が分かる。\e'
	'\0\s[103]映画二時間は長く感じるのに、短い動画は二時間見られる。\e'
	'\0\s[1]写真撮るなら先に言って。\w5変な瞬間だけ残すのなし。\e'
	'\0\s[304]イヤホン、新しいの欲しい。\w5今のも使えるから急がないけど。\e'
	'\0\s[103]ゲームの名前入力で十分迷う。\w5後から変えられないと余計に。\e'
	'\0\s[300]漫画読みながらお菓子食べると、ページに粉落ちる。\w5分かっててもやる。\e'
	'\0\s[317]休日の予定、何もしないを予定として入れたい。\e'
	'\0\s[304]ライブ映像、観客の声が入ってる方がちょっと好き。\e'
	'\0\s[103]途中で止めたゲーム、操作方法から思い出さないといけない。\e'
	'\0\s[7]クリア後の実績一覧、できてないところばっかり見るのよくない。\e'
	'\0\s[304]歌詞を見ないで聴いてた曲、全然違う言葉だと思ってた。\e'
	'\0\s[103]おすすめされすぎると、逆に自分で探したくなる。\e'
	'\0\s[1]かわいい物は好きだよ。\w5持ち物全部そうするほどではないだけ。\e'
	'\0\s[317]散歩って、目的地なくても帰れば完了なのがいい。\e'
	'\0\s[304]古い曲、急に聴きたくなる日ある。\w5理由は特にない。\e'
	'\0\s[103]レビュー読むと満足して、買わないことある。\e'
	'\0\s[7]協力ゲームで一番大事なの、失敗しても笑える人かも。\e'
	'\0\s[304]ピアノ弾けたらいいなとは思う。\w5練習するとはまだ言ってない。\e'
	'\0\s[103]本屋は何も買わなくても時間なくなる。\e'
	'\0\s[317]昼寝、趣味に入れていい？\w5継続してるし。\e'
	'\0\s[304]シャッフル再生なのに、同じ曲ばっかり来る気がする。\e'
	'\0\s[103]ゲームの選択肢、全ルート見たいけど最初は普通に選ぶ。\e'
	'\0\s[1]ぬいぐるみ、増やすつもりないのに増える。\w5勝手には増えないけど。\e'
	'\0\s[304]雨の日に家で音楽聴くの、ちょっと得した感じする。\e'
	'\0\s[103]長いシリーズ、最初から追うか迷って結局保留になる。\e'
	'\0\s[7]対戦ゲーム、負けたまま終わると気になる。\w5勝ってももう一回やるけど。\e'
	'\0\s[317]何か作る趣味ほしい。\w5完成しなくても散らからないやつ。\e'
}

RiaMediaTalks : array
{
	'\0\s[103]最終回だけ評判聞いてから見るの、ちょっとずるい気がする。\e'
	'\0\s[304]オープニング飛ばせるけど、好きなやつは毎回見る。\e'
	'\0\s[3]登場人物多い作品、顔と名前が一致するまで三話かかる。\e'
	'\0\s[103]予告で見せすぎるのやめてほしい。\w5でも予告は見る。\e'
	'\0\s[304]字幕あると、聞こえてても読んじゃう。\e'
	'\0\s[7]ゲームのサウンドトラックだけ先に好きになることある。\e'
	'\0\s[103]原作と映像、どっちから入っても片方に違和感出るよね。\e'
	'\0\s[304]エンドロールの後に何かあるかもって最後まで待つ。\e'
	'\0\s[3]配信終了間近って書いてあると急に観たくなる。\e'
	'\0\s[103]感想を検索したら先の話まで見える罠、何回も踏む。\e'
	'\0\s[304]声が好きなキャラ、台詞少なくても覚えてる。\e'
	'\0\s[7]難易度選択でノーマルを選ぶ時、ちょっと言い訳考える。\e'
	'\0\s[103]続編決定は嬉しいけど、その頃まで内容覚えてるかな。\e'
	'\0\s[304]映像きれいだと、一時停止して背景見たくなる。\e'
	'\0\s[3]推理物、途中で犯人分かった気になる。\w5だいたい外れる。\e'
	'\0\s[103]攻略を見ないで詰まる時間、楽しいのか意地なのか分からない。\e'
	'\0\s[304]挿入歌が流れる場面、だいたい好き。\w5単純かもしれない。\e'
	'\0\s[7]セーブ枠、いっぱいあるのに上から三つしか使わない。\e'
	'\0\s[103]一話だけ見るつもり、信用できない言葉ランキング上位。\e'
	'\0\s[304]昔見た作品、内容より見てた部屋の方を思い出すことある。\e'
	'\0\s[3]タイトルの読み方、ずっと間違えてた。\w5伝わってたからいいけど。\e'
	'\0\s[103]好きな作品を人に勧める時、説明が急に下手になる。\e'
	'\0\s[304]静かな場面で音量上げた直後に大きい音来るの、やめて。\e'
	'\0\s[7]周回プレイ、違う選択するつもりで同じの選ぶ。\e'
	'\0\s[103]ネタバレ避けてる期間、ネット全部危険地帯になる。\e'
}

RiaSiblingTalks : array
{
	'\0\s[103]お兄の物、勝手には使わないよ。\w5充電器くらいは借りるけど。\e'
	'\0\s[0]家族だからって、何でも話すわけじゃないでしょ。\w5話したい時は話す。\e'
	'\0\s[105]帰り遅くなるなら一応連絡して。\w5ごはんの都合あるし。\e'
	'\0\s[9]私のプリン食べたら、同じの二個で返して。\w5利子。\e'
	'\0\s[103]お兄が静かだと、集中してるか寝てるかの二択だよね。\e'
	'\0\s[1]別に頼っていいよ。\w5できることならやる。できないのは知らん。\e'
	'\0\s[3]昔の写真、私だけ変なの選ぶのやめて。\e'
	'\0\s[103]お兄のおすすめ、たまに当たりある。\w5たまにって言った。\e'
	'\0\s[0]同じ部屋で別々のことしてるくらいが、ちょうどよくない。\e'
	'\0\s[105]何か買ってくるなら聞いて。\w5いらないって言うかもしれないけど。\e'
	'\0\s[9]私が間違ってても、嬉しそうに指摘するの禁止。\e'
	'\0\s[103]お兄の独り言、返事必要か分からない。\w5必要なら名前呼んで。\e'
	'\0\s[1]困ってる顔してたら一回は聞くよ。\w5一回だけ。\e'
	'\0\s[3]子供の頃の話、都合いいところだけ覚えてない？\e'
	'\0\s[103]兄妹で好み似る部分と、全然似ない部分あるよね。\e'
	'\0\s[105]お兄が作るなら食べる。\w5味見は先にして。\e'
	'\0\s[0]会話なくても別に怒ってないよ。\w5家でずっと話す方が疲れるでしょ。\e'
	'\0\s[9]勝手に私の代わりに返事しないで。\w5だいたい合ってても嫌。\e'
	'\0\s[103]似てるって言われると微妙。\w5似てないって言われても微妙だけど。\e'
	'\0\s[1]お兄が褒めると何か頼み事あるのかと思う。\w5違うなら、まあありがと。\e'
	'\0\s[105]帰ってきた音くらい分かるよ。\w5毎日聞いてるし。\e'
	'\0\s[3]私の話、聞いてるふりだけはすぐ分かる。\w5今の返事ちょっと遅かった。\e'
	'\0\s[103]お兄に相談すると、たまに話が大きくなる。\w5そこまでしなくていい時もある。\e'
	'\0\s[0]兄妹仲いいのって聞かれたら、普通って答える。\w5実際普通でしょ。\e'
	'\0\s[1]まあ、お兄でよかったとは思ってるよ。\w5比較対象いないけど。\e'
}
