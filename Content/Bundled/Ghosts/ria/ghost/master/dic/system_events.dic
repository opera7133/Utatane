OnShellChanging
{
	_talks = RiaShellChangingTalks
	_talks[RAND(ARRAYSIZE(_talks))]
}

RiaShellChangingTalks : array
{
	'\0\s[103]着替えるの。\w5次の服、変じゃないよね。\e'
	'\0\s[4]また着替え？\w5まあ、一瞬ならいいけど。\e'
	'\0\s[0]シェル変更ね。\w5分かったから、あんまり急かさないで。\e'
}

OnShellChanged
{
	"\0\s[105]これが%(reference0)か。\w5どう、似合ってる？\w5……返事は別にいい。\e"
}

OnBalloonChange
{
	_talks = RiaBalloonChangeTalks
	_talks[RAND(ARRAYSIZE(_talks))]
}

RiaBalloonChangeTalks : array
{
	'\0\s[103]吹き出し替えたんだ。\w5読みやすいなら何でもいいよ。\e'
	'\0\s[1]これ、前より私っぽい？\w5基準は知らないけど。\e'
	'\0\s[0]新しいバルーンね。\w5文字が端にはみ出してなければいい。\e'
}

OnMusicPlayEx
{
	_title = reference0
	_artist = reference1
	_album = ''
	_source = ''
	for _i = 2 ; _i < ARRAYSIZE(reference) ; _i++ {
		_item = SPLIT(reference[_i], CHR(1))
		if ARRAYSIZE(_item) >= 2 {
			if _item[0] == 'album' {
				_album = _item[1]
			}
			elseif _item[0] == 'source' {
				_source = _item[1]
			}
		}
	}

	if _artist == '' {
		"\0\s[304]今流れ始めたの、%(_title)か。\w5曲名は拾えたけど、アーティストまでは分からないみたい。\e"
	}
	elseif _source != '' && _album != '' {
		"\0\s[304]%(_artist)の「%(_title)」。\w5%(_source)で再生中。\w5アルバムは「%(_album)」ね。\e"
	}
	elseif _source != '' {
		"\0\s[304]%(_artist)の「%(_title)」ね。\w5%(_source)で聴いてるんだ。\e"
	}
	else {
		"\0\s[304]%(_artist)の「%(_title)」。\w5ふーん、こういうの聴くんだ。\e"
	}
}

OnMusicPlay
{
	if reference1 == '' {
		"\0\s[304]「%(reference0)」が流れてる。\w5アーティスト名は取れなかったみたい。\e"
	}
	else {
		"\0\s[304]%(reference1)の「%(reference0)」ね。\w5一応、曲名まで見えてる。\e"
	}
}

OnChoiceTimeout
{
	_talks = RiaChoiceTimeoutTalks
	_talks[RAND(ARRAYSIZE(_talks))]
}

RiaChoiceTimeoutTalks : array
{
	'\0\s[103]選ばないなら閉じるよ。\w5ずっと待つほどの話でもないし。\e'
	'\0\s[4]考えてるうちに時間切れ。\w5必要ならもう一回開いて。\e'
	'\0\s[0]返事なしね。\w5じゃ、なかったことにする。\e'
}

OnGhostCalling
{
	"\0\s[103]%(reference0)を呼ぶの。\w5部屋、少し片づけた方がよくない？\e"
}

OnGhostCallComplete
{
	"\0\s[105]%(reference0)来たみたい。\w5私は普通にしてるから、お兄が話して。\e"
}

OnGhostCalled
{
	"\0\s[4]呼ばれた。\w5%(reference0)のところ？\w5まあ、行くけど。\e"
}

OnOtherGhostClosed
{
	_talks = RiaOtherGhostClosedTalks
	_talks[RAND(ARRAYSIZE(_talks))]
}

RiaOtherGhostClosedTalks : array
{
	'\0\s[103]帰ったみたい。\w5急に静かになったね。\e'
	'\0\s[0]お見送りくらいした？\w5もう遅いけど。\e'
	'\0\s[3]二人に戻った。\w5だからって特に話はないけど。\e'
}

OnCommunicate
{
	_text = reference0
	if _text == '' {
		'\0\s[103]何か言いかけた？\w5聞こえなかった。\e'
	}
	elseif _text == 'こんにちは' || _text == 'こんばんは' || _text == 'おはよう' {
		"\0\s[0]%(_text)。\w5わざわざちゃんと挨拶するんだ。\e"
	}
	elseif _text == 'ありがとう' || _text == 'ありがと' {
		'\0\s[1]ん。\w5どういたしまして。\w5そんな改まらなくていいけど。\e'
	}
	elseif _text == 'ごめん' || _text == 'ごめんなさい' {
		OnRiaChoiceApology
	}
	else {
		_talks = RiaCommunicateTalks
		REPLACE(_talks[RAND(ARRAYSIZE(_talks))], '%text%', _text)
	}
}

RiaCommunicateTalks : array
{
	'\0\s[103]「%text%」ね。\w5聞いてる。続けて。\e'
	'\0\s[0]%text%？\w5急に言われても、もう少し説明ないと分からない。\e'
	'\0\s[3]ふーん、%text%か。\w5お兄はそれ、どう思ってるの。\e'
	'\0\s[103]一応覚えとく。\w5今すぐ役に立つかは知らないけど。\e'
}

OnTeach
{
	"\0\s[103]「%(reference0)」を教えたいの。\w5覚える機能はまだないけど、今は聞いた。\e"
}

OnUpdate.OnMD5CompareFailure
{
	'\0\s[6]更新ファイルの中身が合ってない。\w5壊れたまま入れない方がいいよ。\e'
}

OnUpdate.OnDownloadFailure
{
	'\0\s[6]更新ファイルを落とせなかった。\w5回線が戻ってからもう一回でいい。\e'
}

OnUpdate.OnCryptingFailure
{
	'\0\s[6]更新の確認に失敗した。\w5配布側のファイルが変なのかも。\e'
}

OnSysSuspend
{
	ria_suspend_time = GETSECCOUNT()
	_talks = RiaSysSuspendTalks
	if ISFUNC('RiaLocalSysSuspendTalks') {
		_talks ,= EVAL('RiaLocalSysSuspendTalks')
	}
	_talks[RAND(ARRAYSIZE(_talks))]
}

RiaSysSuspendTalks : array
{
	'\0\s[100]スリープ入るの。\w5じゃあ私も寝る。\w5おやすみ、お兄。\e'
	'\0\s[0]画面消すんだ。\w5……作業中のファイル、保存したよね？\e'
	'\0\s[103]システムサスペンドね。\w5私も休んでるから、用ができたら起こして。\e'
	'\0\s[317]お兄も休むの？\w5ならちょうどいい。\w5また後で。\e'
	'\0\s[4]急に寝かせるじゃん。\w5まあいいけど。\w5おやすみ。\e'
}

OnSysResume
{
	_elapsed = 0
	if ISVAR('ria_suspend_time') && TOINT(ria_suspend_time) > 0 {
		_elapsed = GETSECCOUNT() - TOINT(ria_suspend_time)
		ria_suspend_time = 0
	}
	ria_idle_seconds = 0
	ria_touch_sequence = 0
	RiaSelectOutfit
	RiaUpdateTalkInterval

	_talks = IARRAY
	_hour = GETTIME[4]

	if _elapsed >= 7200 {
		_talks ,= '\0\s[100]ふぁ……。\w5結構寝てたかも。\w5お兄、おかえり。\e'
		_talks ,= '\0\s[103]……何時間スリープしてた？\w5私もぐっすり休めたけど。\e'
		_talks ,= '\0\s[0]画面ついた。\w5お兄も少しは休憩できた？\e'
	}
	elseif _elapsed > 0 {
		_talks ,= '\0\s[0]……ん、起きた。\w5もうスリープ解除？\e'
		_talks ,= '\0\s[103]おかえり。\w5作業の続きするの？\e'
		_talks ,= '\0\s[4]ちょっと離れてただけか。\w5画面明るくなって目が覚めた。\e'
		_talks ,= '\0\s[105]スリープ復帰。\w5はいはい、付き合うよ。\e'
	}

	if _hour >= 0 && _hour < 5 {
		_talks ,= '\0\s[100]……こんな時間に起こすの。\w5まだ眠いんだけど、お兄。\e'
	}
	elseif _hour >= 5 && _hour < 10 {
		_talks ,= '\0\s[100]……ん、朝？\w5おはよ、お兄。\w5ちゃんと起きられたんだ。\e'
	}

	if ARRAYSIZE(_talks) == 0 {
		_talks = RiaSysResumeTalks
	}
	else {
		_talks ,= RiaSysResumeTalks
	}

	if ISFUNC('RiaLocalSysResumeTalks') {
		_talks ,= EVAL('RiaLocalSysResumeTalks')
	}
	_talks[RAND(ARRAYSIZE(_talks))]
}

RiaSysResumeTalks : array
{
	'\0\s[0]……ん、起きた。\w5画面ついたね。\e'
	'\0\s[103]スリープ復帰確認。\w5また何か作業するの？\e'
	'\0\s[105]おかえり、お兄。\w5続きやるなら付き合うけど。\e'
	'\0\s[100]ふぁ……。\w5もう復帰？\w5まだ眠い。\e'
}
